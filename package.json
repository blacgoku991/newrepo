{
  "name": "portail-comptes",
  "version": "1.0.0",
  "description": "Portail de demandes de création de comptes sur les applications métiers, avec automatisation Playwright",
  "main": "src/server.js",
  "scripts": {
    "start": "node superadmin/index.js",
    "portail": "node src/server.js",
    "dev": "node --watch superadmin/index.js",
    "postinstall": "playwright install chromium || true",
    "test": "node tests/lancer.js",
    "test:rapide": "node tests/lancer.js --rapide"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/fraunces": "^5.3.0",
    "better-sqlite3": "^11.10.0",
    "express": "^4.21.2",
    "nodemailer": "^9.0.3",
    "playwright": "^1.53.0"
  },
  "license": "MIT"
}
