# ---------------------------------------------------------------------------
# Configuration du Portail Comptes
# Copier ce fichier en `.env` (ou exporter les variables) puis adapter.
# ---------------------------------------------------------------------------

# Port du serveur web
PORT=3000

# Mode simulation : true (défaut) = le robot déroule les scénarios à blanc.
# Passer à false UNIQUEMENT quand les identifiants ci-dessous sont renseignés.
SIMULATION_MODE=true

# Cadence du worker (ms) et délai maximum d'un scénario (ms)
WORKER_POLL_MS=3000
WORKER_TIMEOUT_MS=180000

# --- BlueKanGo ---------------------------------------------------------------
BLUEKANGO_URL=
BLUEKANGO_ADMIN_USER=
BLUEKANGO_ADMIN_PASSWORD=

# --- NetSoins ----------------------------------------------------------------
NETSOINS_URL=
NETSOINS_ADMIN_USER=
NETSOINS_ADMIN_PASSWORD=

# --- ULIS --------------------------------------------------------------------
ULIS_URL=
ULIS_ADMIN_USER=
ULIS_ADMIN_PASSWORD=
