# ---------------------------------------------------------------------------
# Configuration du Portail Comptes
# Copier ce fichier en `.env` (ou exporter les variables) puis adapter.
# ---------------------------------------------------------------------------

# Port du serveur web
PORT=3000

# --- Espace d'administration sécurisé ---------------------------------------
# Compte administrateur initial (créé au 1er démarrage s'il n'en existe aucun).
# ⚠ Sans ADMIN_PASSWORD, un compte « admin » / « admin » est créé : à changer !
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_DISPLAY_NAME=Administrateur
# Durée d'une session admin en millisecondes (défaut : 12 h)
ADMIN_SESSION_TTL_MS=43200000

# --- Frontend hébergé ailleurs (ex. Lovable) --------------------------------
# Origines autorisées à appeler l'API (CORS), séparées par des virgules.
# Ex. : https://mon-app.lovable.app,https://mon-domaine.fr
ALLOWED_ORIGINS=
# Auth cross-domaine par cookie : nécessite HTTPS + ces deux réglages.
# (Sinon, préférer le jeton renvoyé au login, via en-tête Authorization: Bearer.)
ADMIN_COOKIE_SAMESITE=Lax
ADMIN_COOKIE_SECURE=false

# --- SSO Microsoft 365 (Entra ID) — porte d'entrée du site public -----------
# Quand ces 3 variables sont renseignées, l'accès au portail public est réservé
# aux comptes Microsoft 365 du tenant ADEF (l'admin garde sa propre connexion).
# Enregistrement côté Entra ID : Applications > Nouvelle inscription,
# type « Web », URI de redirection = M365_REDIRECT_URI, puis créer un secret.
M365_TENANT_ID=
M365_CLIENT_ID=
M365_CLIENT_SECRET=
# URL de retour après connexion Microsoft (doit être déclarée dans Entra ID).
# Ex. : https://portail.adef-residences.fr/auth/sso/callback
M365_REDIRECT_URI=
# Mettre à false pour désactiver temporairement le SSO sans retirer les clés.
SSO_REQUIRED=true
# Durée d'une session SSO en heures (défaut : 10)
SSO_SESSION_TTL_HOURS=10
# Cookies en HTTPS uniquement (recommandé en production)
COOKIE_SECURE=false

# --- Remise sécurisée des identifiants ---------------------------------------
# L'e-mail ne contient JAMAIS le mot de passe : un lien à usage unique pointe
# vers /identifiants/<jeton> (chiffré en base, consultation tracée).
# URL publique du portail, utilisée pour construire ce lien dans les e-mails.
PUBLIC_BASE_URL=http://localhost:3000
# Durée de validité du lien en jours (défaut : 7)
CREDENTIALS_LINK_TTL_DAYS=7

# --- Envoi des e-mails d'invitation (SMTP) -----------------------------------
# Si non renseigné : les e-mails restent en « boîte d'envoi » dans l'admin
# (à transmettre manuellement). Sinon, envoi automatique après création.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Mode du robot :
#   demo (défaut)  → le robot pilote un vrai navigateur contre la console
#                    d'administration de démonstration intégrée (/demo/<app>).
#   production     → le robot cible les vraies applications métiers.
#                    Nécessite les variables de chaque application ci-dessous ;
#                    une application incomplète retombe automatiquement en démo.
AUTOMATION_MODE=demo

# Cadence du worker (ms), délai max d'un scénario (ms), délai max d'une étape (ms)
WORKER_POLL_MS=3000
WORKER_TIMEOUT_MS=180000
STEP_TIMEOUT_MS=30000

# Chemin d'un Chromium déjà installé (sinon `npx playwright install chromium`)
# CHROMIUM_PATH=/usr/bin/chromium

# --- Voir le robot travailler en direct (débogage, sur votre PC) -------------
# SHOW_BROWSER=true : le robot ouvre une VRAIE fenêtre Chromium que vous voyez
#   bouger en temps réel (nécessite un écran — à utiliser en local, pas sur un
#   serveur sans affichage). Laisser vide/false en production.
# SHOW_BROWSER=true
# ROBOT_SLOWMO : ralentit chaque action du robot, en millisecondes (ex. 500),
#   pour suivre plus facilement à l'œil. 0 = vitesse normale.
# ROBOT_SLOWMO=500

# --- BlueKanGo (instance ADEF Résidences) ------------------------------------
# URL de base SANS /index.php, ex. : https://app.bluekango.com/adef_residences
BLUEKANGO_URL=
BLUEKANGO_ADMIN_USER=
BLUEKANGO_ADMIN_PASSWORD=
# Mot de passe initial attribué aux nouveaux comptes (réinitialisé au 1er login)
BLUEKANGO_DEFAULT_PASSWORD=

# --- NetSoins ----------------------------------------------------------------
NETSOINS_URL=
NETSOINS_ADMIN_USER=
NETSOINS_ADMIN_PASSWORD=

# --- ULIS --------------------------------------------------------------------
ULIS_URL=
ULIS_ADMIN_USER=
ULIS_ADMIN_PASSWORD=
